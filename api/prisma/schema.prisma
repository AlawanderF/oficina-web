generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Usuário do sistema (login). Não conta entre as 4 tabelas do domínio.
model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  senha    String /// hash bcrypt — a senha digitada nunca é armazenada
  criadoEm DateTime @default(now())

  @@map("usuarios")
}

model Cliente {
  id        Int       @id @default(autoincrement())
  nome      String
  cpf       String    @unique
  telefone  String
  email     String
  criadoEm  DateTime  @default(now())
  veiculos  Veiculo[]

  @@map("clientes")
}

/// Veículo -> Cliente (clienteId)
model Veiculo {
  id        Int            @id @default(autoincrement())
  placa     String         @unique
  marca     String
  modelo    String
  ano       Int
  clienteId Int
  cliente   Cliente        @relation(fields: [clienteId], references: [id])
  ordens    OrdemServico[]
  criadoEm  DateTime       @default(now())

  @@index([clienteId])
  @@map("veiculos")
}

model Mecanico {
  id            Int            @id @default(autoincrement())
  nome          String
  especialidade String
  telefone      String
  ordens        OrdemServico[]
  criadoEm      DateTime       @default(now())

  @@map("mecanicos")
}

enum StatusOrdem {
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

/// Ordem de serviço -> Veículo (veiculoId) e Mecânico (mecanicoId): ligada a duas tabelas
model OrdemServico {
  id            Int         @id @default(autoincrement())
  descricao     String
  status        StatusOrdem @default(ABERTA)
  valor         Decimal     @db.Decimal(10, 2)
  dataAbertura  DateTime    @db.Date
  dataConclusao DateTime?   @db.Date
  veiculoId     Int
  mecanicoId    Int
  veiculo       Veiculo     @relation(fields: [veiculoId], references: [id])
  mecanico      Mecanico    @relation(fields: [mecanicoId], references: [id])
  criadoEm      DateTime    @default(now())

  @@index([veiculoId])
  @@index([mecanicoId])
  @@map("ordens_servico")
}
